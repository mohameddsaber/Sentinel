{
  "manifest_version": 3,
  "name": "Sentinel",
  "version": "0.1.0",
  "description": "Deep work mode with distraction loop detection and session reports.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deep Work"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"] ,
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
