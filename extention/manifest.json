{
  "manifest_version": 3,
  "name": "Sentinel",
  "version": "0.1.0",
  "description": "Deep work mode with distraction loop detection and session reports.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Deep Work",
    "default_icon": {
      "128": "favicon/web-app-manifest-192x192.png",
      "48": "favicon/favicon-96x96.png",
      "16": "favicon/favicon-96x96.png"
    }
  },
  "icons": {
    "128": "favicon/web-app-manifest-192x192.png",
    "48": "favicon/favicon-96x96.png",
    "16": "favicon/favicon-96x96.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"] ,
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js",
        "blocked/soft_blocked.html",
        "blocked/hard_blocked.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
